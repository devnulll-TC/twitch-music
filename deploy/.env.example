# Образец /root/twitch-music/.env (на сервере — права 600).
# Файл читают ОБА: docker compose (для liquidsoap) и сам tm-service.
# Реальные значения на сервере, в репозитории их нет и быть не должно.

# --- поток ---
STREAM_USER=              # логин harbor; попадает прямо в URL для OBS
STREAM_PASS=              # пароль harbor — единственная защита порта 8000 (ufw его не прикрывает!)
STREAM_MOUNT=/…           # точка монтирования эфира, например /stream.mp3
MONITOR_MOUNT=/…          # второй поток, для наушников стримера (Monitor Only в OBS)
STREAM_HOST=187.124.187.72:8000   # адрес, который увидит OBS

# --- веб ---
WEB_PREFIX=               # ДЛИННЫЙ случайный префикс пути; это секрет, auth_basic для него отключён
WEB_PORT=8030             # слушаем только 127.0.0.1, наружу выводит nginx
# PUBLIC_BASE=https://get.dev-nulll.com   # дефолт в коде, менять при смене домена

# --- Twitch (dev.twitch.tv → приложение) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Redirect URL приложения обязан совпадать с:
#   https://get.dev-nulll.com/<WEB_PREFIX>/twitch/callback

# --- Spotify (только каталог/поиск, звук технически невозможен) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- панель ---
PANEL_SECRET=             # ключ HMAC: подписывает куку панели и ключ OBS-дока; смена отзывает всё
PANEL_ALLOW=              # логины модеров через запятую (стример разрешён всегда).
                          # ⚠️ каждый ник сверять через Helix: похожий ник — другой человек

# --- необязательное (дефолты в коде) ---
# BROADCASTER_LOGIN=f1pah
# BOT_LOGIN=devnulll_music
# REWARD_TITLE=Заказать трек
# REWARD_COST=500          # стартовая цена; дальше её крутит панель (settings.json)
# REWARD_COOLDOWN=30       # секунд между активациями, 0 = без кулдауна
# MAX_DURATION=600         # секунд; дальше лимит живёт в settings.json
# CACHE_DIR=/root/twitch-music/cache
# PLAYER_CACHE_DIR=/cache  # ⚠️ как тот же каталог видит контейнер liquidsoap
# PLAYER_ADDR=127.0.0.1:1234
# YTDLP_BIN=/usr/local/bin/yt-dlp
# YT_COOKIES=/root/twitch-music/secrets/youtube-cookies.txt
